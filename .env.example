# --- Database utama: Google Sheets lewat Apps Script (apps-script/) ---
# Nilai sama dengan API_SECRET di file Rahasia.gs pada editor Apps Script.
APPS_SCRIPT_SECRET=
# Opsional: URL Web App /exec. Kosong = URL deployment bawaan di lib/repo/index.ts
APPS_SCRIPT_URL=

# --- Alternatif: Google Sheets API dengan service account (dipakai bila APPS_SCRIPT_SECRET kosong) ---
# Kosongkan semua bagian database untuk mode lokal berbasis file .data/
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Tempel private key service account; boleh dengan \n literal
GOOGLE_PRIVATE_KEY=
SHEET_ID=

# --- Sesi admin ---
# Opsional. Kosong = diturunkan dari APPS_SCRIPT_SECRET. Minimal 32 karakter: openssl rand -base64 48
SESSION_SECRET=
# Admin pertama (owner). Dipakai hanya bila sheet "admins" masih kosong.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Tangkapan layar (opsional) ---
# Folder di Shared Drive yang sudah dibagikan ke service account (editor).
# Kosong = tangkapan layar disimpan di DATA_DIR/uploads (cocok untuk server/Dokploy, tidak untuk Vercel).
DRIVE_FOLDER_ID=

# --- Adapter metrik pihak ketiga (opsional, default mati di sheet settings) ---
METRICS_API_KEY=
# RapidAPI: host dan URL endpoint, {url} diganti link konten
RAPIDAPI_HOST=
RAPIDAPI_TIKTOK_URL=
RAPIDAPI_REELS_URL=
# Apify: ID actor per platform
APIFY_TIKTOK_ACTOR=
APIFY_REELS_ACTOR=

# --- Lainnya ---
# Lokasi data mode lokal (default ./.data)
DATA_DIR=
